generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum SalonType {
  CHAT
  CONTRIBUTION
}

enum MemberRole {
  ADMIN
  MEMBER
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REMOVED
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

model User {
  id                String           @id @default(cuid())
  username          String           @unique @db.VarChar(40)
  displayName       String           @db.VarChar(80)
  email             String           @unique @db.VarChar(191)
  passwordHash      String           @db.VarChar(255)
  avatarUrl         String?          @db.LongText
  bio               String?          @db.Text
  securityQuestion  String?          @db.VarChar(255)
  securityAnswer    String?          @db.VarChar(255)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  createdSalons     Salon[]          @relation("SalonCreator")
  memberships       SalonMember[]
  sentMessages      Message[]
  recordedPayments  ContributionPayment[] @relation("PaymentRecorder")
  receivedPayments  ContributionPayment[] @relation("PaymentRecipient")
  sentFriendships   Friendship[]    @relation("FriendshipRequester")
  receivedFriendships Friendship[]   @relation("FriendshipAddressee")
  joinRequests      SalonJoinRequest[]
  posts             Post[]
  postLikes         PostLike[]
  postComments      PostComment[]
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

model Salon {
  id                String       @id @default(cuid())
  name              String       @db.VarChar(100)
  description       String?      @db.Text
  rules             String?      @db.Text
  type              SalonType
  isDiscoverable    Boolean      @default(true)
  contributionAmount Decimal?    @db.Decimal(12, 2)
  successThreshold  Decimal?     @db.Decimal(12, 2)
  currency          String       @default("USD") @db.VarChar(3)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  creatorId         String
  creator           User         @relation("SalonCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  members           SalonMember[]
  messages          Message[]
  payments          ContributionPayment[]
  joinRequests      SalonJoinRequest[]

  @@index([type, isDiscoverable])
}

model SalonMember {
  id             String           @id @default(cuid())
  salonId        String
  userId         String
  role           MemberRole       @default(MEMBER)
  status         MembershipStatus @default(ACTIVE)
  assignedAmount Decimal?         @db.Decimal(12, 2)
  joinedAt       DateTime         @default(now())
  salon          Salon            @relation(fields: [salonId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([salonId, userId])
  @@index([userId, status])
}

model SalonJoinRequest {
  id        String   @id @default(cuid())
  salonId   String
  userId    String
  message   String?  @db.VarChar(500)
  createdAt DateTime @default(now())
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([salonId, userId])
}

model Message {
  id        String   @id @default(cuid())
  salonId   String
  authorId  String
  content   String   @db.Text
  createdAt DateTime @default(now())
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([salonId, createdAt])
}

model ContributionPayment {
  id            String   @id @default(cuid())
  salonId       String
  recipientId   String
  recordedById  String
  amount        Decimal  @db.Decimal(12, 2)
  paidAt        DateTime
  reason        String?  @db.VarChar(255)
  createdAt     DateTime @default(now())
  salon         Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  recipient     User     @relation("PaymentRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  recordedBy    User     @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([salonId, paidAt])
  @@index([recipientId, salonId])
}

model Post {
  id          String        @id @default(cuid())
  authorId    String
  content     String        @db.Text
  mediaType   String?       @db.VarChar(20)
  mediaUrl    String?       @db.LongText
  sharesCount Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  author      User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes       PostLike[]
  comments    PostComment[]

  @@index([createdAt])
  @@index([authorId])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String   @db.Text
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}
